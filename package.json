{
  "name": "scalable-capital-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop client for Scalable Capital's MCP",
  "author": "Suneet Kumar",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "check:tauri": "node scripts/check-tauri-versions.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "lint": "eslint src scripts vite.config.ts eslint.config.js",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,js,ts}\" vite.config.ts eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,js,ts}\" vite.config.ts eslint.config.js",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri-dev": "tauri dev"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-opener": "2.7.1",
    "lightweight-charts": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
