{
  "name": "scalable-capital-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop client for Scalable Capital's MCP",
  "author": "Suneet Kumar",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "typecheck": "tsc --noEmit",
    "check:tauri": "node scripts/check-tauri-versions.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "lint": "vp lint src scripts e2e extensions/trailing-stops/web vite.config.ts playwright.config.ts",
    "format": "vp fmt \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,js,ts}\" \"e2e/**/*.ts\" \"extensions/trailing-stops/web/**/*.{ts,tsx}\" vite.config.ts playwright.config.ts",
    "format:check": "vp fmt --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,js,ts}\" \"e2e/**/*.ts\" \"extensions/trailing-stops/web/**/*.{ts,tsx}\" vite.config.ts playwright.config.ts",
    "test": "vp test run",
    "test:ui": "playwright test",
    "preview": "vp preview",
    "tauri": "tauri",
    "tauri-dev": "tauri dev"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@tanstack/react-table": "9.3.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "lightweight-charts": "5.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
